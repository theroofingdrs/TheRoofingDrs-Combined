rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "theroofingdrs@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer records: only admins/staff can list all, customers can read/write their own
    match /customers/{customerId} {
      allow get: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && (incoming().userId == request.auth.uid || isAdmin()) && isValidId(customerId);
      allow update: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidId(customerId);
      allow delete: if isAdmin();
    }

    // Properties: tied to customer or admin
    match /properties/{propertyId} {
      allow get: if isVerifiedUser() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(propertyId);
      allow update: if isVerifiedUser() && isValidId(propertyId) && (resource.data.customerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Roofs & Roof Records
    match /roofs/{roofId} {
      allow get: if isVerifiedUser();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(roofId);
      allow delete: if isAdmin();
    }

    match /roofRecords/{recordId} {
      allow get: if isVerifiedUser();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(recordId);
      allow delete: if isAdmin();
    }

    // Leads: Anyone can submit a lead request from the public website
    match /leads/{leadId} {
      allow create: if isValidId(leadId) && incoming().phone is string && incoming().name is string;
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Projects, Inspections, Measurements, Appointments
    match /projects/{projectId} {
      allow get: if isVerifiedUser() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(projectId);
    }

    match /inspections/{inspectionId} {
      allow get: if isVerifiedUser() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(inspectionId);
    }

    match /measurements/{measurementId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(measurementId);
    }

    match /appointments/{appointmentId} {
      allow get: if isVerifiedUser() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() && isValidId(appointmentId);
      allow update: if (isAdmin() || (isVerifiedUser() && resource.data.customerId == request.auth.uid)) && isValidId(appointmentId);
      allow delete: if isAdmin();
    }

    // Audit Logs: Append-only by server/admin, never modified or deleted
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(auditId);
      allow update, delete: if false;
    }
  }
}
